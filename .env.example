# Public RPC endpoint for read/write chain access.
SEPOLIA_RPC_URL=

# ERC-4337 bundler endpoint compatible with EntryPoint v0.8.
SEPOLIA_BUNDLER_RPC_URL=

# Optional paymaster endpoint. Leave empty until sponsorship is configured.
SEPOLIA_PAYMASTER_RPC_URL=

# Testnet-only deployer key. Never commit a real value.
DEPLOYER_PRIVATE_KEY=

# Optional explorer verification key.
ETHERSCAN_API_KEY=

# Deployment configuration. Keep these empty unless running the deployment script.
ENTRY_POINT_ADDRESS=
PAYMASTER_ADMIN=
SPONSOR_SIGNER=
PAYMASTER_BUDGET=

# Optional read-model indexer.
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis
AEGIS_FACTORY_ADDRESS=
INDEXER_FROM_BLOCK=0
